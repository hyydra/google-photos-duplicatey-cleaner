# Optional: Google OAuth 2.0 Web Client ID (Recommended over Firebase)
# You can also enter this directly in the app's UI settings modal without editing this file.
VITE_GOOGLE_CLIENT_ID=

# Firebase Client Configuration (Alternative OAuth provider)
# Optional: only needed if you prefer using Firebase Auth
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=


