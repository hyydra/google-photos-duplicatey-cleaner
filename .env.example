# Firebase Client Configuration (Optional for Google Photos OAuth scan)
# Local image dropzone and Demo/Sample mode work without any configuration.
# To connect to live Google Photos / Drive, copy this file to .env.local and fill in your Firebase Web App credentials:

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=

